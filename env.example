# Copie este arquivo para .env para desenvolvimento local
# No Render, configure como Environment Variables no painel

# URL do seu projeto Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave service_role (NUNCA exponha no frontend)
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL de redirecionamento após o usuário clicar no link do e-mail
REDIRECT_URL=https://www.sgirenovar.com.br/login.html

# Origens permitidas (separadas por vírgula)
# Use * para liberar tudo (só em desenvolvimento!)
ALLOWED_ORIGINS=https://www.sgirenovar.com.br,https://sgirenovar.com.br

# Porta local (Render define automaticamente)
PORT=3000
